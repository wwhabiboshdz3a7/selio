{
  "name": "@selio/studio-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Protocole de validation de Studio (§5.11) sur nos propres photos : lecture des étiquettes et des mesures, rapport Markdown daté. Aucune photo dans le dépôt.",
  "scripts": {
    "eval": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@selio/ai": "workspace:*",
    "@selio/contracts": "workspace:*",
    "@selio/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
