# Configuration de la sauvegarde de Selio — modèle À COPIER, jamais à remplir ici.
#   sudo install -m 600 -o root -g root scripts/sauvegarde/backup.env.example /etc/selio/backup.env
# puis remplacer les valeurs factices. Le fichier doit rester en 600 : les scripts refusent un
# fichier modifiable par d'autres utilisateurs. Détails : docs/SAUVEGARDE.md.

# --- PostgreSQL (UNE des deux façons) -----------------------------------------------------------
# a) Docker Compose (deploy/docker-compose.prod.yml, port non publié) : nom du conteneur PostgreSQL
#    (docker ps). Les outils du conteneur sont utilisés, sans mot de passe.
BACKUP_PG_DOCKER_CONTAINER=
BACKUP_PG_USER=selio
BACKUP_PG_DB=selio
# b) PostgreSQL installé sur la machine : rôle PROPRIÉTAIRE (superutilisateur ou BYPASSRLS), jamais
#    selio_app (la RLS forcée rendrait les tables vides). Mot de passe conseillé dans ~/.pgpass
#    (chmod 600) plutôt que dans l'adresse.
DATABASE_URL=postgres://selio@127.0.0.1:5432/selio

# --- Dossier local et rotation ------------------------------------------------------------------
BACKUP_DIR=/var/backups/selio
BACKUP_KEEP_DAYS=30
# Sauvegardes locales gardées quoi qu'il arrive (même plus vieilles que BACKUP_KEEP_DAYS)
BACKUP_KEEP_MIN=3
# Journal (défaut : $BACKUP_DIR/backup.log ; le test de restauration écrit restore-test.log)
BACKUP_LOG_FILE=

# --- Chiffrement (age conseillé ; gpg à défaut) -------------------------------------------------
# age : UNE OU PLUSIEURS clés PUBLIQUES séparées par des virgules (portable de secours + clé papier).
# La clé privée n'est JAMAIS sur cette machine. Générer sur le portable : age-keygen -o selio-sauvegarde.key
# (la ligne « public key: age1… » affichée est la valeur à mettre ici). Format : age1…,age1…
BACKUP_AGE_RECIPIENT=
# gpg symétrique (seulement sans age) : fichier contenant la phrase de passe, chmod 600.
BACKUP_PASSPHRASE_FILE=

# --- Photos (MinIO) -----------------------------------------------------------------------------
# Source rclone des objets : remote « s3 » (provider Minio) déclaré dans rclone.conf avec une clé
# en LECTURE SEULE sur le bucket, suivi du bucket, ex. selio-minio:selio-photos.
# Vide = photos non sauvegardées (avertissement dans le journal).
BACKUP_MINIO_SOURCE=

# --- Copie hors machine (rclone) ----------------------------------------------------------------
# Destination rclone hors de la machine (portable de secours en SFTP, disque d'un proche, stockage
# en France…) : à choisir avec Ibrahim, ex. selio-hors-machine:selio-sauvegardes.
# Vide = la sauvegarde locale est faite mais le script finit avec le code 3.
BACKUP_RCLONE_REMOTE=
# Fichier de configuration rclone (défaut : celui de l'utilisateur, ~/.config/rclone/rclone.conf)
BACKUP_RCLONE_CONFIG=/etc/selio/rclone.conf

# --- Test de restauration (restore-test.sh, sur le portable de secours de préférence) -----------
# Connexion d'administration (superutilisateur) à la base « postgres » du serveur de test
RESTORE_DATABASE_URL=postgres://selio@127.0.0.1:5432/postgres
# Base temporaire (doit commencer par selio_restore_test ; supprimée à la fin)
RESTORE_DB_NAME=selio_restore_test
# Clé privée age (fichier sur le portable ou une clé USB branchée pour le test, chmod 600)
BACKUP_AGE_IDENTITY=/chemin/vers/selio-sauvegarde.key
RESTORE_CHECK_PHOTOS=true
