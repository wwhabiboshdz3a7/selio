# =====================================================================================================
#  SELIO — CLÉS DE PRODUCTION (modèle à recopier, NE PAS REMPLIR CE FICHIER-CI)
# =====================================================================================================
#
#  Mode d'emploi (5 minutes, sur la machine de production) :
#
#    1. Copier ce modèle en « deploy/.env » (ce nom est ignoré par Git : il ne partira jamais sur GitHub) :
#         Windows (PowerShell) : Copy-Item deploy\cles-production.modele.env deploy\.env
#         Linux / WSL          : cp deploy/cles-production.modele.env deploy/.env
#    2. Générer les secrets automatiques (mots de passe, clé de chiffrement, clés des notifications…) :
#         node deploy/generer-secrets.mjs
#       Le script remplace chaque « A_GENERER » par une valeur aléatoire et n'affiche AUCUNE valeur.
#    3. Remplacer à la main chaque « A_REMPLIR » (liste plus bas, avec où trouver chaque valeur).
#    4. Vérifier :
#         node deploy/verifier-cles.mjs
#       Le rapport ne contient aucune valeur secrète : c'est lui (et seulement lui) qu'on peut m'envoyer.
#
#  Règles :
#    - Ne jamais coller une clé, un mot de passe ou ce fichier rempli dans une conversation, un e-mail ou Git.
#    - Garder une copie chiffrée de « deploy/.env » hors de la machine (docs/SAUVEGARDE.md §1.1) :
#      sans SECRETS_ENCRYPTION_KEY, les secrets chiffrés en base sont perdus.
#    - Les lignes marquées « NE PAS CHANGER » sont des garde-fous : l'API refuse de démarrer sans eux.
#
#  Légende :   A_GENERER = rempli par generer-secrets.mjs   ·   A_REMPLIR = à fournir par toi
#              (vide)    = facultatif, laisser vide tant que le service n'est pas choisi
#  Détail de chaque variable : docs/CLES-ET-CONFIGURATION.md · tuto de la machine : docs/PC-WINDOWS-IA.md
# =====================================================================================================


# -----------------------------------------------------------------------------------------------------
# 1. ADRESSES PUBLIQUES (A_REMPLIR)
# -----------------------------------------------------------------------------------------------------
# Adresse du site (Netlify), sans « / » final. Ex. https://selio.fr ou https://selio-app.netlify.app
PUBLIC_WEB_URL=A_REMPLIR
# Origines autorisées à appeler l'API : la même adresse que PUBLIC_WEB_URL (plusieurs : séparées par des virgules)
CORS_ORIGINS=A_REMPLIR
# Adresse publique de l'API (sert au tunnel et au webhook Revolut). Ex. https://api.selio.fr
API_PUBLIC_URL=A_REMPLIR
# E-mails des comptes qui auront l'administration Selio (/admin), séparés par des virgules
OPERATOR_EMAILS=A_REMPLIR


# -----------------------------------------------------------------------------------------------------
# 2. BASE DE DONNÉES, FILE DE TÂCHES, CHIFFREMENT (A_GENERER)
# -----------------------------------------------------------------------------------------------------
# Mot de passe du propriétaire de la base (migrations seulement)
POSTGRES_PASSWORD=A_GENERER
# Mot de passe du rôle applicatif « selio_app » (l'isolation par organisation s'applique à lui)
APP_DB_PASSWORD=A_GENERER
# Clé de chiffrement des secrets en base (32 octets, base64). À SAUVEGARDER À PART.
SECRETS_ENCRYPTION_KEY=A_GENERER
# DATABASE_URL et REDIS_URL sont fournies par docker-compose.prod.yml : ne pas les mettre ici.


# -----------------------------------------------------------------------------------------------------
# 3. GARDE-FOUS DE PRODUCTION (NE PAS CHANGER)
# -----------------------------------------------------------------------------------------------------
NODE_ENV=production
COOKIE_SECURE=true
TRUST_PROXY=true
LOG_LEVEL=info


# -----------------------------------------------------------------------------------------------------
# 4. IA : « MON IA PERSO » ET SES DEUX MODÈLES (Ollama sur la machine, voir docs/PC-WINDOWS-IA.md)
# -----------------------------------------------------------------------------------------------------
AI_PROVIDER=ollama
# Adresse d'Ollama vue depuis les conteneurs :
#   - Ollama sur le même PC (Windows + Docker Desktop, ou Linux) : http://host.docker.internal:11434
#   - Ollama sur un autre PC relié par Tailscale : http://100.x.y.z:11434 (adresse Tailscale du PC de l'IA)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Nom exact du modèle de texte choisi (« mon IA perso »), tel qu'affiché par « ollama list ». Ex. qwen2.5:7b-instruct
OLLAMA_MODEL=A_REMPLIR
# Modèle 1, les photos (Studio). Ne changer que si un autre modèle de vision est installé.
OLLAMA_VISION_MODEL=qwen3-vl:8b
# Modèle 2, les prix (embeddings)
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# Facultatif : « Bearer … » seulement si une passerelle protège Ollama
OLLAMA_AUTH_HEADER=
# Jeton qui protège la page de supervision /api/ai/health
AI_HEALTH_TOKEN=A_GENERER
# NE PAS CHANGER : jamais de texte simulé présenté comme venant du modèle
ALLOW_AI_FALLBACK=false
# Réglages de capacité : garder ces valeurs, puis les ajuster après « pnpm ai:bench » sur la machine
AI_TIMEOUT_MS=45000
AI_MAX_CONCURRENCY=2
AI_CONTEXT_LIMIT=8192
AI_MAX_OUTPUT_TOKENS=700


# -----------------------------------------------------------------------------------------------------
# 5. PHOTOS : Garage SUR LA MACHINE (stockage compatible S3, lancé par deploy/docker-compose.machine.yml)
# -----------------------------------------------------------------------------------------------------
# Adresse publique du stockage, appelée directement par le navigateur. Ex. https://photos.selio.fr
STORAGE_ENDPOINT=A_REMPLIR
STORAGE_BUCKET=selio-photos
# NE PAS CHANGER : identique à s3_region dans deploy/garage/garage.toml (elle fait partie de la signature)
STORAGE_REGION=fr-mrs-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_TTL_SECONDS=900
# Place réservée aux photos sur le disque de la machine (ex. 200G, 500G). Modifiable seulement avant le premier démarrage.
GARAGE_CAPACITY=200G
# Secrets internes de Garage (jamais transmis à l'API ni au worker)
GARAGE_RPC_SECRET=A_GENERER
GARAGE_ADMIN_TOKEN=A_GENERER
# Clé dédiée à l'API : lecture + écriture sur le bucket, rien d'autre (créée automatiquement au démarrage)
STORAGE_ACCESS_KEY=A_GENERER
STORAGE_SECRET_KEY=A_GENERER


# -----------------------------------------------------------------------------------------------------
# 6. TUNNEL CHIFFRÉ (Cloudflare Tunnel) : publie l'API et les photos sans ouvrir de port sur la box
# -----------------------------------------------------------------------------------------------------
# Jeton du tunnel : Cloudflare Zero Trust › Networks › Tunnels › Create a tunnel › « Cloudflared » ›
# copier la longue valeur après « --token » (étapes détaillées : docs/PC-WINDOWS-IA.md, partie 5).
CLOUDFLARE_TUNNEL_TOKEN=A_REMPLIR


# -----------------------------------------------------------------------------------------------------
# 7. NOTIFICATIONS SUR LE TÉLÉPHONE (alertes Selio Radar)
# -----------------------------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=A_GENERER
VAPID_PRIVATE_KEY=A_GENERER
# Une vraie adresse de contact, précédée de « mailto: ». Ex. mailto:contact@selio.fr
VAPID_SUBJECT=A_REMPLIR


# -----------------------------------------------------------------------------------------------------
# 8. E-MAILS (invitations, mot de passe oublié, échec de paiement)
# -----------------------------------------------------------------------------------------------------
# noop = rien n'est envoyé (accepté, mais signalé au démarrage). smtp = envoi réel.
EMAIL_PROVIDER=noop
# Avec smtp : smtps://utilisateur:motdepasse@smtp.fournisseur.fr:465 (donné par le service d'e-mail choisi)
SMTP_URL=
# Expéditeur affiché ; le domaine doit être déclaré chez le service d'e-mail (SPF/DKIM). Ex. Selio <no-reply@selio.fr>
EMAIL_FROM=


# -----------------------------------------------------------------------------------------------------
# 9. PAIEMENT DES ABONNEMENTS (Revolut Business › Merchant › API) — BAC À SABLE D'ABORD
# -----------------------------------------------------------------------------------------------------
# Vide = paiement désactivé (les essais finissent en accès de base, rien n'est débité).
# Clé SECRÈTE « sk_… » (jamais la clé publique) :
REVOLUT_SECRET_KEY=
# Secret « wsk_… » renvoyé à la création du webhook (commande dans docs/CLES-ET-CONFIGURATION.md §5)
REVOLUT_WEBHOOK_SECRET=
REVOLUT_MODE=sandbox
REVOLUT_API_VERSION=2026-08-17
# NE PAS CHANGER avant d'avoir validé tout le parcours en bac à sable (sinon : refus de démarrer en « live »)
REVOLUT_LIVE_ALLOWED=false
# true si Selio est en franchise en base de TVA (factures à 0 % avec mention légale), false = TVA 20 %
FRANCHISE_TVA=A_REMPLIR


# -----------------------------------------------------------------------------------------------------
# 10. SELIO CLOUD ET RADAR AUTO — FERMÉS (NE PAS CHANGER avant l'avis écrit de l'avocat)
# -----------------------------------------------------------------------------------------------------
CLOUD_ENABLED=false
CLOUD_HEAVY_ACTIONS=false
CLOUD_PRO_OPTION=false
RADAR_AUTO_ENABLED=false
RADAR_AUTO_ORG_IDS=
RADAR_REAL_PURCHASE=false


# =====================================================================================================
#  À SAISIR AILLEURS (pas dans ce fichier)
# =====================================================================================================
#  Netlify › Site configuration › Environment variables (valeurs PUBLIQUES, aucun secret) :
#    VITE_API_BASE_URL         = la valeur de API_PUBLIC_URL ci-dessus
#    VITE_INVOICE_ISSUER_NAME  = raison sociale (ex. Selio SAS)
#    VITE_INVOICE_ISSUER_ADDRESS = adresse, lignes séparées par « | »
#    VITE_INVOICE_ISSUER_SIREN / VITE_INVOICE_ISSUER_VAT / VITE_INVOICE_ISSUER_EMAIL
#  Sauvegarde : fichier à part, à partir de scripts/sauvegarde/backup.env.example (docs/SAUVEGARDE.md).
#  Ollama (sur le PC de l'IA) : variables Windows OLLAMA_* décrites dans docs/PC-WINDOWS-IA.md.
# =====================================================================================================
