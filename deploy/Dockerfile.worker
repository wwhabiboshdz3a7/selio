# Worker Selio — image de production, avec Chromium pour Selio Cloud, Selio Track en réel et l'achat automatique.
# Base Debian (glibc) : Chromium et ses dépendances système s'y installent proprement.
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY apps/worker/package.json apps/worker/
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @selio/worker... --ignore-scripts
COPY apps/worker ./apps/worker
RUN pnpm --filter @selio/worker build && pnpm --filter @selio/worker --prod deploy --legacy /out

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY --from=build /out /app
COPY --from=build /repo/apps/worker/dist /app/dist
# Chromium de la même version que playwright-core, ses dépendances système et des polices lisibles.
# Lien stable /usr/local/bin/selio-chromium : c'est la valeur de CLOUD_CHROMIUM_PATH.
RUN node /app/node_modules/playwright-core/cli.js install --with-deps chromium \
 && apt-get update && apt-get install -y --no-install-recommends fonts-liberation fonts-dejavu-core fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/* \
 && CHROME="$(ls -d /ms-playwright/chromium-*/chrome-linux*/chrome | head -n 1)" \
 && test -x "$CHROME" \
 && ln -s "$CHROME" /usr/local/bin/selio-chromium \
 && mkdir -p /var/lib/selio-cloud && chown node:node /var/lib/selio-cloud && chmod 700 /var/lib/selio-cloud
# Jamais root : le bac à sable de Chromium s'appuie sur les espaces de noms utilisateur
# (profil seccomp deploy/chromium-seccomp.json, voir docker-compose.prod.yml).
USER node
CMD ["node", "dist/main.js"]
