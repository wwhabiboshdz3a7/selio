# Worker Selio — image de production
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY apps/worker/package.json apps/worker/
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @selio/worker... --ignore-scripts
COPY apps/worker ./apps/worker
RUN pnpm --filter @selio/worker build && pnpm --filter @selio/worker --prod deploy /out

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out /app
COPY --from=build /repo/apps/worker/dist /app/dist
USER node
CMD ["node", "dist/main.js"]
