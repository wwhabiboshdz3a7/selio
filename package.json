{
  "name": "selio-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @selio/web dev",
    "dev:api": "pnpm --filter @selio/api dev",
    "dev:worker": "pnpm --filter @selio/worker dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "build:web": "pnpm --filter @selio/web build",
    "build:api": "pnpm --filter @selio/api build",
    "build:worker": "pnpm --filter @selio/worker build",
    "build:extension": "pnpm --filter @selio/extension build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project domain --project contracts --project ai --project connectors --project ui --project web --project extension",
    "test:integration": "vitest run --project api --project worker --project db",
    "test:e2e": "pnpm --filter @selio/web test:e2e",
    "db:migrate": "pnpm --filter @selio/db migrate",
    "db:seed:demo": "pnpm --filter @selio/db seed:demo",
    "ai:diagnose": "pnpm --filter @selio/ai diagnose",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "argon2",
      "msgpackr-extract",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "type": "module"
}
