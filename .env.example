# Copie ce fichier en ".env" pour le developpement local avec `netlify dev`.
# En production, ces valeurs se configurent dans Netlify :
# Site configuration > Environment variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # cle "service_role" (secrete, jamais cote client)
