# apps/web — variables PUBLIQUES uniquement (préfixe VITE_, embarquées dans le bundle).
# Ne jamais y mettre de secret.

# URL de l'API en mode connecté. Vide = l'application ne propose que le mode démonstration.
VITE_API_BASE_URL=

# Cible du proxy /api en développement (vite dev)
VITE_DEV_API_PROXY=http://127.0.0.1:8787

# Afficher les tarifs indicatifs sur la vitrine (true/false)
VITE_SHOW_INDICATIVE_PRICING=true
