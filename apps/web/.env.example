# apps/web — variables PUBLIQUES uniquement (préfixe VITE_, embarquées dans le bundle).
# Ne jamais y mettre de secret.

# URL de l'API en mode connecté. Vide = l'application ne propose que le mode démonstration.
VITE_API_BASE_URL=

# Cible du proxy /api en développement (vite dev)
VITE_DEV_API_PROXY=http://127.0.0.1:8787

# Afficher les tarifs indicatifs sur la vitrine (true/false)
VITE_SHOW_INDICATIVE_PRICING=true

# Mentions de l'émetteur sur les factures (Paramètres › Factures). Publiques, sans secret.
# Vides = « à compléter » affiché sur la facture (à renseigner avant la première facture réelle).
# Raison sociale (défaut : Selio), adresse (lignes séparées par « | »), SIREN, numéro de TVA intracommunautaire, email de contact.
VITE_INVOICE_ISSUER_NAME=
VITE_INVOICE_ISSUER_ADDRESS=
VITE_INVOICE_ISSUER_SIREN=
VITE_INVOICE_ISSUER_VAT=
VITE_INVOICE_ISSUER_EMAIL=
