# apps/api — variables d'environnement (placeholders uniquement, ne jamais committer de valeur réelle).

# Réseau
PORT=8787
HOST=0.0.0.0
# Origines autorisées (CORS avec cookies), séparées par des virgules
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# URL publique de l'application web (redirections de paiement)
PUBLIC_WEB_URL=http://127.0.0.1:5173
# Derrière un reverse proxy (Caddy/Nginx) : true pour lire X-Forwarded-For
TRUST_PROXY=false
# Cookies sécurisés (true en production HTTPS)
COOKIE_SECURE=false
LOG_LEVEL=info

# Base de données : rôle applicatif NON superuser (RLS appliquée)
DATABASE_URL=postgres://selio_app:selio_app@127.0.0.1:5432/selio
# Le rôle propriétaire (selio) n'est utilisé que par `pnpm db:migrate` / `node dist/migrate.js` (variable DATABASE_URL au moment de la migration)
# MIGRATIONS_DIR=/chemin/vers/migrations   # facultatif pour un bundle déployé

# File de tâches (optionnelle : sans Redis, les tâches s'exécutent inline)
REDIS_URL=redis://127.0.0.1:6379

# Coffre serveur : clé de 32 octets en base64 (générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SECRETS_ENCRYPTION_KEY=remplacer-par-une-cle-base64-de-32-octets

# Opérateurs Selio (emails séparés par des virgules) : accès à l'administration
OPERATOR_EMAILS=

# Assistant IA (voir packages/ai et docs/OLLAMA-SETUP.md) — en production, AI_PROVIDER=ollama et ALLOW_AI_FALLBACK=false
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Trois modèles, tous via Ollama sur la machine :
# « Mon IA perso » (texte : réponses, annonces, aide). Le nom du modèle est donné à part par Ibrahim.
OLLAMA_MODEL=qwen2.5:7b-instruct
# Modèle 1, « les photos » (Studio, lecture et contrôle des photos). Vide = annonces rédigées sans lire les photos (signalé à l'écran).
OLLAMA_VISION_MODEL=qwen3-vl:8b
# Modèle 2, « les prix » (embeddings pour retrouver les ventes comparables). Vide = embeddings désactivés.
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# En-tête d'autorisation d'une passerelle devant Ollama (facultatif), ex. « Bearer xxx »
OLLAMA_AUTH_HEADER=
AI_TIMEOUT_MS=45000
# Aligné sur OLLAMA_NUM_PARALLEL ; à régler après pnpm ai:bench sur la machine
AI_MAX_CONCURRENCY=2
AI_CONTEXT_LIMIT=8192
AI_MAX_OUTPUT_TOKENS=700
AI_HEALTH_TOKEN=remplacer-par-un-jeton-long
ALLOW_AI_FALLBACK=false

# Paiement : Revolut Merchant API (abonnements, carte enregistrée « pour le marchand », webhooks).
# Vide = paiement désactivé (aucune commande créée, l'interface le dit). Clé secrète du compte marchand (sk_…), jamais la clé publique.
REVOLUT_SECRET_KEY=
# Secret de signature des webhooks (wsk_…), renvoyé par POST /api/1.0/webhooks lors de l'enregistrement de l'URL
# https://<api>/api/billing/webhook/revolut pour les événements ORDER_COMPLETED, ORDER_AUTHORISED, ORDER_PAYMENT_DECLINED, ORDER_PAYMENT_FAILED, ORDER_CANCELLED.
REVOLUT_WEBHOOK_SECRET=
# sandbox (https://sandbox-merchant.revolut.com, défaut) ou live (https://merchant.revolut.com, exige REVOLUT_LIVE_ALLOWED=true)
REVOLUT_MODE=sandbox
# Version de l'API Revolut (en-tête Revolut-Api-Version)
REVOLUT_API_VERSION=2026-08-17
# Garde-fou : le mode live (argent réel) est refusé tant que cette variable n'est pas explicitement true
REVOLUT_LIVE_ALLOWED=false
# Franchise en base de TVA (art. 293 B du CGI) : true = factures à 0 % avec la mention légale ; false = TVA 20 %
FRANCHISE_TVA=false

# Emails transactionnels (invitations, mot de passe oublié, échec de paiement, alertes)
# noop = aucun envoi, journalisé avec l'adresse masquée (démo, tests) ; smtp = envoi réel via SMTP_URL.
# En production, noop est accepté mais signalé au démarrage : le service d'email reste à choisir avec Ibrahim.
EMAIL_PROVIDER=noop
# smtp://utilisateur:motdepasse@smtp.exemple.fr:587 (STARTTLS) ou smtps://utilisateur:motdepasse@smtp.exemple.fr:465 (TLS direct)
SMTP_URL=
EMAIL_FROM=Selio <no-reply@localhost>

# Stockage des photos : objet compatible S3 (MinIO sur la machine, `docker compose up -d minio`). Voir docs/STOCKAGE.md.
# Vide = stockage désactivé, /api/uploads répond 503 (démo, tests). Renseigné = bucket et clés obligatoires.
STORAGE_ENDPOINT=
STORAGE_REGION=fr-mrs-1
STORAGE_BUCKET=selio-photos
STORAGE_ACCESS_KEY=remplacer-par-l-identifiant-minio
STORAGE_SECRET_KEY=remplacer-par-le-secret-minio
# true : endpoint/bucket/clé (MinIO) ; false : bucket.endpoint/clé (S3 « virtual-hosted »)
STORAGE_FORCE_PATH_STYLE=true
# Durée de vie des URLs signées, en secondes (60 à 604800 ; viser court)
STORAGE_PRESIGN_TTL_SECONDS=900

# Selio Cloud (automatisation quand l'ordinateur du client est éteint). L'API ne lance jamais de navigateur :
# elle garde l'accord, les comptes et le journal, met en file la fenêtre de connexion (file « selio-cloud-login »)
# et relaie ses images et les entrées du client par Redis (WebSocket /api/cloud/login/:id/ws, ticket à usage court).
# false (défaut) = réglages consultables, fenêtre de connexion indisponible (503). true exige REDIS_URL.
CLOUD_ENABLED=false
# Navigateurs ouverts en même temps sur la machine (défaut prudent 5). La cible de 50 est une hypothèse à mesurer (pnpm cloud:bench).
CLOUD_MAX_BROWSERS=5
# Comptes Cloud au plus par organisation (jamais au-delà des comptes Vinted de l'offre)
CLOUD_MAX_ACCOUNTS_PER_ORG=10
# Actions lourdes (republier, modifier en masse) sur l'adresse IP partagée : false tant qu'Ibrahim n'a pas décidé
CLOUD_HEAVY_ACTIONS=false
# Cloud en option avec l'offre Pro (prix à décider, rien n'est facturé) : false = compris dans Agence seulement
CLOUD_PRO_OPTION=false
# Heures actives (« début-fin », fuseau de l'organisation) : aucune action la nuit
CLOUD_ACTIVE_HOURS=8-23
# Validité d'une fenêtre de connexion (ticket), en millisecondes : 5 minutes
CLOUD_LOGIN_TIMEOUT_MS=300000
# Les variables propres au navigateur (CLOUD_CHROMIUM_PATH, CLOUD_ACTION_TIMEOUT_MS, CLOUD_PROFILE_DIR, CRON_CLOUD)
# ne servent qu'au worker : voir apps/worker/.env.example.

# Notifications Web Push de la PWA (alertes Selio Radar : bonnes affaires, paiement 3-D Secure à valider,
# pause du compte Achat). Clés VAPID du serveur, à générer UNE fois (npx web-push generate-vapid-keys) et à
# reporter à l'identique dans le worker. Vide = notifications désactivées (GET /api/push/config → enabled: false,
# les alertes restent en file). Seuls les services de notification des navigateurs sont contactés
# (Google, Mozilla, Microsoft, Apple). La clé privée ne quitte jamais le serveur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact de l'émetteur exigé par les services de notification (mailto: ou https:)
VAPID_SUBJECT=mailto:contact@exemple.invalid

# Selio Radar Auto (achat automatique). Premier verrou, côté serveur : false par défaut, réservé aux comptes de
# l'équipe pour les tests. PAS activable pour les clients sur l'adresse partagée tant qu'Ibrahim n'a pas tranché.
RADAR_AUTO_ENABLED=false
# Organisations de l'équipe autorisées (identifiants séparés par des virgules) ; obligatoire en production si
# RADAR_AUTO_ENABLED=true. Toute autre organisation est refusée.
RADAR_AUTO_ORG_IDS=
# Achat réel (D11) : false = le parcours s'arrête avant le bouton de paiement (achat enregistré « simulé »).
RADAR_REAL_PURCHASE=false
# Attente de la validation 3-D Secure par le client (ms, 60000 à 1800000) : même valeur que le worker
CLOUD_3DS_TIMEOUT_MS=600000
