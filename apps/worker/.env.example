# apps/worker — mêmes variables que l'API pour la base, Redis, le coffre et l'IA (placeholders uniquement).
DATABASE_URL=postgres://selio_app:selio_app@127.0.0.1:5432/selio
REDIS_URL=redis://127.0.0.1:6379
SECRETS_ENCRYPTION_KEY=remplacer-par-une-cle-base64-de-32-octets
LOG_LEVEL=info
NODE_ENV=development

AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
AI_TIMEOUT_MS=45000
AI_MAX_CONCURRENCY=2
AI_CONTEXT_LIMIT=8192
AI_MAX_OUTPUT_TOKENS=400
ALLOW_AI_FALLBACK=false

# Cadences (expressions cron, UTC)
CRON_AUTOMATION_TICK=*/5 * * * *
CRON_JOBS_PROCESS=* * * * *
CRON_CONNECTOR_SYNC=*/15 * * * *
CRON_RADAR=0 * * * *
CRON_RETENTION=0 3 * * *
