# apps/worker — mêmes variables que l'API pour la base, Redis, le coffre et l'IA (placeholders uniquement).
DATABASE_URL=postgres://selio_app:selio_app@127.0.0.1:5432/selio
REDIS_URL=redis://127.0.0.1:6379
SECRETS_ENCRYPTION_KEY=remplacer-par-une-cle-base64-de-32-octets
LOG_LEVEL=info
NODE_ENV=development

# Assistant IA (voir packages/ai et docs/OLLAMA-SETUP.md) — mêmes valeurs que l'API
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Trois modèles, tous via Ollama sur la machine :
# « Mon IA perso » (texte : réponses, annonces, aide). Le nom du modèle est donné à part par Ibrahim.
OLLAMA_MODEL=qwen2.5:7b-instruct
# Modèle 1, « les photos » (Studio, lecture et contrôle des photos). Vide = annonces rédigées sans lire les photos (signalé à l'écran).
OLLAMA_VISION_MODEL=qwen3-vl:8b
# Modèle 2, « les prix » (embeddings pour retrouver les ventes comparables). Vide = embeddings désactivés.
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# OCR d'essai pour les étiquettes difficiles (ex. GLM-OCR) : FACULTATIF, vide par défaut. Le worker ne lit pas d'étiquettes
# aujourd'hui (préparation Studio dans l'API) ; même valeur que l'API pour un diagnostic cohérent.
OLLAMA_OCR_MODEL=
# En-tête d'autorisation d'une passerelle devant Ollama (facultatif), ex. « Bearer xxx »
OLLAMA_AUTH_HEADER=
AI_TIMEOUT_MS=45000
# Aligné sur OLLAMA_NUM_PARALLEL ; à régler après pnpm ai:bench sur la machine
AI_MAX_CONCURRENCY=2
AI_CONTEXT_LIMIT=8192
AI_MAX_OUTPUT_TOKENS=700
ALLOW_AI_FALLBACK=false

# Paiement Revolut — mêmes valeurs que l'API : le worker débite les renouvellements avec le moyen de paiement
# enregistré « pour le marchand » (tâche horaire billing.renew). Vide = aucun débit tenté ; seules les fins
# d'essai sans carte sont appliquées. REVOLUT_WEBHOOK_SECRET n'est pas utile ici (les webhooks arrivent à l'API).
REVOLUT_SECRET_KEY=
REVOLUT_MODE=sandbox
REVOLUT_API_VERSION=2026-08-17
REVOLUT_LIVE_ALLOWED=false
# Franchise en base de TVA (art. 293 B du CGI) : même valeur que l'API (factures de renouvellement)
FRANCHISE_TVA=false
# URL publique du site : lien « Mettre à jour mon moyen de paiement » dans les emails d'échec
PUBLIC_WEB_URL=http://127.0.0.1:5173

# Emails transactionnels — mêmes valeurs que l'API : le worker envoie les emails d'échec de paiement
# (échéance puis relances J+1 / J+3 / J+7, retour à l'accès de base). noop = journalisé, rien n'est envoyé.
EMAIL_PROVIDER=noop
SMTP_URL=
EMAIL_FROM=Selio <no-reply@localhost>

# Stockage des photos — mêmes valeurs que l'API. Réservé à la purge des objets orphelins (à planifier) ; ignoré aujourd'hui.
STORAGE_ENDPOINT=
STORAGE_REGION=fr-mrs-1
STORAGE_BUCKET=selio-photos
STORAGE_ACCESS_KEY=remplacer-par-l-identifiant-minio
STORAGE_SECRET_KEY=remplacer-par-le-secret-minio
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_TTL_SECONDS=900

# Cadences (expressions cron, UTC)
CRON_AUTOMATION_TICK=*/5 * * * *
CRON_JOBS_PROCESS=* * * * *
CRON_CONNECTOR_SYNC=*/15 * * * *
CRON_RETENTION=0 3 * * *

# Supervision (« supervision.tick » chaque minute) : contrôle de /api/health et /api/ai/health.
# Après 3 échecs consécutifs : alerte Web Push (appareils abonnés des opérateurs, clés VAPID ci-dessous)
# et email (fournisseur d'email ci-dessous) ; rappel toutes les 60 min ; « rétabli » notifié.
CRON_SUPERVISION=* * * * *
# Adresse de l'API vue depuis le worker (même machine).
PUBLIC_API_URL=http://127.0.0.1:8787
# Opérateurs Selio (mêmes adresses que l'API, virgules) : destinataires des alertes.
OPERATOR_EMAILS=
# Jeton de /api/ai/health (même valeur que l'API, 16 caractères au moins). Absent : seule /api/health
# est contrôlée. Décommenter et remplacer :
# AI_HEALTH_TOKEN=remplacer-par-le-meme-jeton-que-l-api
# Cibles personnalisées (JSON, champs name et url seulement). Vide : les deux adresses ci-dessus.
# Exemple : [{"name":"api","url":"http://127.0.0.1:8787/api/health"}]
SUPERVISION_TARGETS=
SUPERVISION_FAILURES_BEFORE_ALERT=3
SUPERVISION_REMINDER_MINUTES=60
SUPERVISION_TIMEOUT_MS=10000
# OPTION EXTERNE (désactivée) : le worker tourne sur la même machine que l'API ; si toute la machine
# tombe, il ne peut prévenir personne. Un service de disponibilité gratuit peut, au choix :
#   - interroger https://<adresse publique de l'API>/api/health de l'extérieur (sonde HTTP, alerte s'il
#     ne répond plus) : rien à régler ici, l'adresse doit seulement être joignable depuis Internet ;
#   - attendre un « battement » du worker : renseigner ci-dessous l'adresse https fournie par ce service
#     (appelée chaque minute quand tout va bien ; sans battement, le service prévient).
# Aucun service n'est choisi ni activé : à décider avec Ibrahim (offre gratuite, sans carte bancaire).
SUPERVISION_HEARTBEAT_URL=
# Échéances d'abonnement : renouvellements, fins d'essai, relances J+1 / J+3 / J+7 (calculées à l'heure
# de l'échéance : un passage horaire les tient le jour annoncé par email), annulation des autorisations
# de vérification restées posées. Idempotent : rien n'est tenté hors échéance.
CRON_BILLING_RENEW=0 * * * *

# Selio Cloud : Chromium ouvert seulement pour agir (une action, au rythme humain, dans les plafonds de l'offre,
# puis fermeture) ou pour la fenêtre de connexion où le client se connecte lui-même (aucun mot de passe gardé).
# Sans CLOUD_ENABLED=true ET CLOUD_CHROMIUM_PATH, rien ne s'exécute (« Cloud désactivé » dans le journal).
CLOUD_ENABLED=false
# Exécutable Chromium installé sur la machine (aucun téléchargement), ex. /opt/chromium/chrome
CLOUD_CHROMIUM_PATH=
# Navigateur sans fenêtre
CLOUD_HEADLESS=true
# Bac à sable de Chromium : TOUJOURS true en production (false refusé au démarrage). Le worker vérifie au
# démarrage que Chromium se lance avec son bac à sable, sinon le Cloud reste désactivé (docs/CLOUD.md §7).
# false n'est permis que sur un poste de développement où le worker tourne en root.
CLOUD_CHROMIUM_SANDBOX=true
# Navigateurs simultanés, actions et fenêtres de connexion confondues (défaut prudent 5 ; 50 = hypothèse à mesurer).
# Les fenêtres de connexion n'en prennent jamais plus que CLOUD_MAX_BROWSERS - 1 : un créneau reste aux actions.
CLOUD_MAX_BROWSERS=5
# Mêmes valeurs que l'API
CLOUD_MAX_ACCOUNTS_PER_ORG=10
CLOUD_HEAVY_ACTIONS=false
CLOUD_PRO_OPTION=false
CLOUD_ACTIVE_HOURS=8-23
# Expiration de la fenêtre de connexion (ms) : 5 minutes, jamais au-delà du ticket
CLOUD_LOGIN_TIMEOUT_MS=300000
# Durée maximale d'une action, navigateur compris (ms)
CLOUD_ACTION_TIMEOUT_MS=90000
# Dossiers de travail temporaires de Chromium (HOME, TMPDIR ; un par exécution, droits 0700, supprimé à la fin ;
# les cookies restent en mémoire). Réservé à CE worker : tout « selio-cloud-* » restant est supprimé au démarrage.
# Conseillé : un tmpfs. Vide = <dossier temporaire>/selio-cloud
CLOUD_PROFILE_DIR=
# Passage du planificateur du Cloud (UTC) : une action au plus par compte et par passage
CRON_CLOUD=* * * * *

# Selio Radar. Passage toutes les 30 s (ms) : recherches dues selon leur rythme (60 s en direct, 30 s pour les
# 3 prioritaires quand Radar Auto est actif, 1 h pour le simulateur), multiplié par le facteur de ralentissement
# (au-delà de 1 blocage pour 1 000 pages, l'intervalle double). Lecture en direct seulement depuis le compte Achat
# relié à Selio Cloud (CLOUD_ENABLED=true et Chromium) ; sinon seules les recherches du simulateur sont lues.
# Au premier CAPTCHA, avertissement, blocage ou « trop de requêtes » : arrêt, compte Achat en pause, client alerté.
RADAR_TICK_EVERY_MS=30000
# Pages lues en direct par minute sur toute la machine (toutes organisations) ; le plafond par organisation est
# un réglage de l'organisation (10 par défaut).
RADAR_MAX_PAGES_PER_MINUTE_GLOBAL=30
# Budget d'une lecture de page (ms, navigateur compris) et d'un achat jusqu'au paiement (ms, hors 3-D Secure)
RADAR_PAGE_BUDGET_MS=30000
RADAR_PURCHASE_TIMEOUT_MS=90000
# Envoi des alertes en file (notifications de la PWA), expression cron UTC : chaque minute
CRON_ALERTS=* * * * *
# Notifications Web Push : mêmes clés VAPID que l'API (npx web-push generate-vapid-keys, une seule fois).
# Vide = aucune notification envoyée, les alertes restent en file (et expirent après 12 h).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.invalid

# Radar Auto (achat automatique) : false par défaut, réservé aux comptes de l'équipe pour les tests, PAS activable
# pour les clients sur l'adresse partagée tant qu'Ibrahim n'a pas tranché. Mêmes valeurs que l'API.
RADAR_AUTO_ENABLED=false
# Organisations de l'équipe autorisées (virgules) ; obligatoire en production si RADAR_AUTO_ENABLED=true
RADAR_AUTO_ORG_IDS=
# Achat réel (D11) : false = le parcours s'arrête avant le bouton de paiement (achat enregistré « simulé »)
RADAR_REAL_PURCHASE=false
# Passage de Radar Auto (ms), seulement si RADAR_AUTO_ENABLED=true : un achat par le navigateur au plus par passage
RADAR_AUTO_EVERY_MS=30000
# Validation 3-D Secure : le navigateur de l'achat reste ouvert ce temps-là (ms, 60000 à 1800000) pendant que le
# client valide dans l'application de sa banque ; Selio ne saisit jamais de code à sa place. Délai passé :
# achat abandonné, alerte « vérifiez dans Vinted », rien n'est racheté. Même valeur que l'API.
CLOUD_3DS_TIMEOUT_MS=600000

# Selio Track (Pro et Agence) : STATISTIQUES SEULEMENT — aucune annonce republiée, aucune photo ni aucun pseudo
# conservé ; les annonces ne sont reconnues d'une lecture à l'autre que par une empreinte salée calculée par la base.
# Passage toutes les 15 min (cron UTC) : les filtres identiques entre clients sont lus UNE seule fois (empreinte
# normalisée des critères), toutes les TRACK_READ_INTERVAL_MINUTES × facteur de ralentissement partagé.
CRON_TRACK=*/15 * * * *
# false (défaut) = simulateur, données marquées « démonstration ». true = pages PUBLIQUES du catalogue lues par le
# navigateur de Selio Cloud (exige CLOUD_ENABLED=true et Chromium ; aucune session, mêmes créneaux de navigateurs,
# arrêt au premier CAPTCHA / blocage / « trop de requêtes », pause de Track, ralentissement, coupe-circuit de la
# machine, rien n'est retenté ni contourné). Usage des données issues de Vinted À VALIDER JURIDIQUEMENT. Même valeur que l'API.
TRACK_LIVE_ENABLED=false
# Relecture d'une empreinte suivie (minutes, 60 à 1440) : 2 h
TRACK_READ_INTERVAL_MINUTES=120
# Pages publiques lues par Track par minute ; elles comptent AUSSI dans RADAR_MAX_PAGES_PER_MINUTE_GLOBAL (machine)
TRACK_MAX_PAGES_PER_MINUTE=10

# Estimation des prix (modèle de prix, §5.10). Chaque nuit : ventes des organisations QUI L'ONT ACCEPTÉ (Paramètres ›
# IA, désactivé par défaut, à valider juridiquement) ajoutées à la base de références (sans client, titre,
# identifiant ni photo, dates au jour) ; ventes remboursées, annulées ou supprimées retirées. Chaque dimanche à
# 04:00 UTC : entraînement du gradient boosting quantile (P25 / P50 / P75 et délai) sur les VENTES du passé, test
# sur le dernier mois jamais vu (ventes au prix réel seulement), dans un fil séparé, modèle chargé en mémoire par
# le worker puis par l'API (rechargement horaire). Sous PRICING_MIN_REFERENCES ventes réelles, le modèle est
# entraîné sur les données de démonstration et affiché comme tel ; en dessous du seuil, aucun modèle.
CRON_PRICING_REFERENCES=30 2 * * *
PRICING_TRAIN_CRON=0 4 * * 0
# 500 au moins (l'entraîneur refuse en dessous de 500 ventes avant le mois de test)
PRICING_MIN_REFERENCES=500
# Durée maximale d'un entraînement (ms) : au-delà, le fil est arrêté et l'ancien modèle reste actif
PRICING_TRAIN_MAX_MS=600000

# Studio — photos portées (§5.11), traitées la nuit par la tâche « studio.worn » (toutes les 10 min, rien n'est lancé
# hors de la fenêtre). AUCUN modèle ni service choisi (décision d'Ibrahim) : noop (défaut) refuse chaque demande
# proprement (« aucun fournisseur configuré : décision à prendre »), quota rendu ; mock = test (aucune image), interdit en production.
CRON_STUDIO_WORN=*/10 * * * *
WORN_PHOTO_PROVIDER=noop
WORN_NIGHT_WINDOW=22-6
WORN_NIGHT_TIMEZONE=Europe/Paris
# Dépassement du quota (10 en Pro, 30 en Agence) facturé au renouvellement (ligne de la facture Revolut), avec l'accord explicite
# du client : false par défaut. Prix en centimes (25 = 0,25 €) : PROPOSITION, à confirmer. Mêmes valeurs que l'API.
WORN_OVERAGE_ENABLED=false
WORN_OVERAGE_CENTS=25

# Parrainage « un mois offert aux deux » : false par défaut (même valeur que l'API). Le worker encaisse le premier
# prélèvement après l'essai : sans cette variable, ce paiement ne qualifierait pas le parrainage.
REFERRAL_ENABLED=false
